+def test_ablation_rows_build_and_only_the_control_sees_band_order():
+    """Why the control needs its own tokenizer.
+
+    With the band tokenizer, no spectral blocks and no skip, the model is a
+    mean over groups: shuffling the 14 groups changes nothing. That row
+    cannot tell where in the spectrum a dip sits, so it is not the
+    band-collapsed control. The collapsed tokenizer and the fused model both
+    react to the shuffle.
+    """
+    torch.manual_seed(0)
+    images = torch.rand(1, 224, 16, 16)
+    order = torch.randperm(14)
+    shuffled = images.reshape(1, 14, 16, 16, 16)[:, order].reshape(1, 224, 16, 16)
+
+    def change(model):
+        model.eval()
+        with torch.no_grad():
+            return (model(images) - model(shuffled)).abs().max().item()
+
+    assert change(BandTransformer(0, 2)) < 1e-6  # mean-pooled groups: order-blind
+    assert change(BandTransformer(0, 2, tokenizer="collapsed")) > 1e-3
+    # At random init the fused model reacts weakly (about 1e-4 here): band
+    # order reaches it only through the group embedding inside attention.
+    assert change(BandTransformer(1, 1)) > 1e-5
+    assert change(BandTransformer(0, 2, head_skip=True)) > 1e-3  # the skip sees band order
