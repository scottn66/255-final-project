+class CollapsedTokenizer(nn.Module):
+    """Control tokenizer: mix all bands first, then patch-embed.
+
+    ``(B, C, H, W) -> tokens (B, h*w, 1, D)`` and the ``(h, w)`` grid. There
+    is one group (``G = 1``), so the band axis is gone before any attention.
+
+    A 1x1 conv reduces ``n_bands`` to ``reduce`` channels, then the same
+    ``Conv2d(reduce -> D, patch, patch)`` and LayerNorm as ``BandTokenizer``.
+    With ``reduce = 16`` it has 69,328 parameters against 66,624 for the band
+    tokenizer. Unlike ``BandTokenizer`` plus a mean over groups, it can tell
+    which part of the spectrum a feature sits in. Use it with
+    ``depth_spectral=0`` as the band-collapsed row of the Phase 2 ablation.
+    """
+
+    def __init__(self, n_bands=224, d_model=64, reduce=16, patch=8):
+        super().__init__()
+        if reduce < 1:
+            raise ValueError(f"reduce must be >= 1, got {reduce}")
+        self.n_bands = n_bands
+        self.group = n_bands
+        self.n_groups = 1
+        self.reduce = nn.Conv2d(n_bands, reduce, kernel_size=1)
+        self.proj = nn.Conv2d(reduce, d_model, kernel_size=patch, stride=patch)
+        self.norm = nn.LayerNorm(d_model)
+
+    def forward(self, x):
+        if x.shape[1] != self.n_bands:
+            raise ValueError(f"Input has {x.shape[1]} bands but tokenizer expects {self.n_bands}")
+        t = self.proj(self.reduce(x))  # (B, D, h, w)
+        h, w = t.shape[-2:]
+        t = self.norm(t.flatten(2).transpose(1, 2))  # (B, h*w, D)
+        return t.unsqueeze(2), (h, w)  # (B, h*w, 1, D)
